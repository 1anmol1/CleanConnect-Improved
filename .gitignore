# Dependencies
# Ignore all node_modules directories throughout the entire project.
**/node_modules

# Environment Variables
# Ignore all .env files, which contain secret keys and should never be committed.
.env
.env.*
# Explicitly ignore the server's environment file
/server/.env
# Do NOT ignore .env.example files, as they are templates.
!.env.example

# Build & Output Folders
# Ignore the production build folder from the client application.
/client/dist
/build

# Logs
# Ignore log files, which are machine-specific.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS-generated files
# Ignore system files generated by macOS and Windows.
.DS_Store
Thumbs.db

# Editor-specific directories
# Ignore files generated by code editors like VS Code.
.vscode/
.idea/

