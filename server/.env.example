# Server Configuration
PORT=5000

# MongoDB Connection String
# Replace the placeholder below with your actual connection string from MongoDB Atlas.
# Using a cloud database is recommended over a local one for reliability.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/CleanConnect?retryWrites=true&w=majority
MONGO_URI=
# JSON Web Token Configuration
# Use a long, random, and secret string for JWT_SECRET in a production environment.
JWT_SECRET=
# Google API Keys
# This key is for server-side AI services. Keep it secret.
GEMINI_API_KEY=

# This key is for the frontend Google Maps. It will be visible in the browser.
# IMPORTANT: Restrict this key in the Google Cloud Console to your website's domain.
VITE_GOOGLE_MAPS_API_KEY=

# ... your other variables like MONGO_URI and JWT_SECRET
DEVICE_API_KEY=""

RECAPTCHA_SECRET_KEY=""

VITE_API_URL=http://localhost:5000/api

VITE_DUSTBIN_API_URL=http://localhost:5000/api/bins

VITE_RECAPTCHA_SITE_KEY=""
